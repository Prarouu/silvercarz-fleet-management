# Supabase — client-safe keys (RLS is the security boundary).
# Copy this file to .env.local and fill in values from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Invoice numbering — company prefix for SC-YYYY-XXXX (server-only).
# Defaults to SC when unset. Future company settings can override this.
INVOICE_COMPANY_PREFIX=SC

# ---------------------------------------------------------------------------
# Admin / staff accounts (database-controlled — not env-driven)
# ---------------------------------------------------------------------------
# Public signup always creates `customer` profiles.
# Only emails in public.staff_allowlist become owner/manager.
#
# After applying migrations, review/adjust allowlist in the Supabase SQL editor:
#
#   SELECT * FROM public.staff_allowlist;
#
#   INSERT INTO public.staff_allowlist (email, role)
#   VALUES ('owner@yourcompany.com', 'owner')
#   ON CONFLICT (email) DO UPDATE SET role = EXCLUDED.role;
#
#   UPDATE public.profiles
#   SET role = 'owner'
#   WHERE lower(email) = lower('owner@yourcompany.com');
#
#   SELECT * FROM public.apply_staff_allowlist();
# ---------------------------------------------------------------------------